---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Making from '../components/Making.astro';
import Now from '../components/Now.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Mayibongwe Sibanda, software engineer and side-project builder';
const description =
  'Software engineer in Johannesburg. This is where my side projects live, from a personal finance and health dashboard to whatever I am tinkering with next.';
---

<BaseLayout title={title} description={description} path="/">
  <Header />
  <main>
    <Hero />
    <hr class="divider" />
    <Making />
    <Now />
    <hr class="divider" />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
